#!/usr/bin/env bash
# ${description}
set -euo pipefail
args=(--rm -i --network host --read-only --cap-drop ALL --security-opt no-new-privileges
  -v /etc/oxabl-cache/server.toml:/etc/oxabl-cache/server.toml:ro
  -v /etc/oxabl-cache/secrets:/run/secrets/oxabl-cache:ro)
%{ if data_mount != "" ~}
args+=(-v ${data_mount}:/var/lib/oxabl-cache)
%{ endif ~}
%{ if entrypoint != "" ~}
args+=(--entrypoint ${entrypoint} --user 0:0 -e OXABL_CACHE_ADMIN_SERVER=${admin_server} -e OXABL_CACHE_ADMIN_TOKEN_FILE=/run/secrets/operator-token)
%{ if add_host != "" ~}
args+=(--add-host ${add_host}:127.0.0.1)
%{ endif ~}
if [ -f /etc/oxabl-cache/operator-token ]; then
  args+=(-v /etc/oxabl-cache/operator-token:/run/secrets/operator-token:ro)
fi
%{ endif ~}
exec podman run "$${args[@]}" ${image} "$@"
