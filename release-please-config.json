{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "plugins": [
    "cargo-workspace"
  ],
  "bump-minor-pre-major": true,
  "packages": {
    "crates/oxabl-cache-format": {
      "release-type": "rust",
      "changelog-path": "CHANGELOG.md",
      "extra-files": [
        {
          "type": "toml",
          "path": "/scripts/gate-fixture/Cargo.lock",
          "jsonpath": "$.package[?(@.name.value=='oxabl-cache-format')].version"
        },
        {
          "type": "toml",
          "path": "/desktop/Cargo.lock",
          "jsonpath": "$.package[?(@.name.value=='oxabl-cache-format')].version"
        },
        {
          "type": "toml",
          "path": "/fuzz/Cargo.lock",
          "jsonpath": "$.package[?(@.name.value=='oxabl-cache-format')].version"
        }
      ]
    },
    "crates/oxabl-cache-crypto": {
      "release-type": "rust",
      "changelog-path": "CHANGELOG.md",
      "extra-files": [
        {
          "type": "toml",
          "path": "/scripts/gate-fixture/Cargo.lock",
          "jsonpath": "$.package[?(@.name.value=='oxabl-cache-crypto')].version"
        },
        {
          "type": "toml",
          "path": "/desktop/Cargo.lock",
          "jsonpath": "$.package[?(@.name.value=='oxabl-cache-crypto')].version"
        },
        {
          "type": "toml",
          "path": "/fuzz/Cargo.lock",
          "jsonpath": "$.package[?(@.name.value=='oxabl-cache-crypto')].version"
        }
      ]
    },
    "crates/oxabl-cache-client": {
      "release-type": "rust",
      "changelog-path": "CHANGELOG.md",
      "extra-files": [
        {
          "type": "toml",
          "path": "/desktop/Cargo.lock",
          "jsonpath": "$.package[?(@.name.value=='oxabl-cache-client')].version"
        }
      ]
    },
    "crates/oxabl-cache-admin": {
      "release-type": "rust",
      "skip-github-release": true,
      "skip-changelog": true
    },
    "crates/oxabl-cache-cli": {
      "release-type": "rust",
      "skip-github-release": true,
      "skip-changelog": true
    },
    "crates/oxabl-cache-core": {
      "release-type": "rust",
      "skip-github-release": true,
      "skip-changelog": true
    },
    "crates/oxabl-cache-http": {
      "release-type": "rust",
      "skip-github-release": true,
      "skip-changelog": true
    },
    "crates/oxabl-cache-meta-postgres": {
      "release-type": "rust",
      "skip-github-release": true,
      "skip-changelog": true
    },
    "crates/oxabl-cache-meta-sqlite": {
      "release-type": "rust",
      "skip-github-release": true,
      "skip-changelog": true
    },
    "crates/oxabl-cache-oidc": {
      "release-type": "rust",
      "skip-github-release": true,
      "skip-changelog": true
    },
    "crates/oxabl-cache-server": {
      "release-type": "rust",
      "skip-github-release": true,
      "skip-changelog": true
    },
    "crates/oxabl-cache-store-fs": {
      "release-type": "rust",
      "skip-github-release": true,
      "skip-changelog": true
    },
    "crates/oxabl-cache-store-s3": {
      "release-type": "rust",
      "skip-github-release": true,
      "skip-changelog": true
    },
    "tests/e2e": {
      "release-type": "rust",
      "skip-github-release": true,
      "skip-changelog": true,
      "extra-files": [
        {
          "type": "toml",
          "path": "/desktop/Cargo.lock",
          "jsonpath": "$.package[?(@.name.value=='oxabl-cache-e2e')].version"
        }
      ]
    },
    "tests/core-behaviour": {
      "release-type": "rust",
      "skip-github-release": true,
      "skip-changelog": true
    },
    "desktop": {
      "release-type": "simple",
      "package-name": "oxabl-cache-desktop",
      "component": "oxabl-cache-desktop",
      "changelog-path": "CHANGELOG.md",
      "extra-files": [
        {
          "type": "toml",
          "path": "Cargo.toml",
          "jsonpath": "$.package.version"
        },
        {
          "type": "toml",
          "path": "/desktop/Cargo.lock",
          "jsonpath": "$.package[?(@.name.value=='oxabl-cache-desktop')].version"
        }
      ]
    }
  }
}
